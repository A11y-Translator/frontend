# 복사해서 .env.local 로 저장하세요 (.env.local 은 git 에 올라가지 않아요). 바꾼 뒤에는 npm run dev 를 다시 켜야 해요.

# live(기본: 개발 서버가 직접 검사) · http(백엔드 서버) · mock(임시 규칙)
VITE_API_MODE=http

# 백엔드 주소. 개발 서버가 /api 요청을 여기로 넘겨줍니다 (기본값 http://127.0.0.1:8000)
BACKEND_ORIGIN=http://127.0.0.1:8000

# http 모드에서 쓸 개발 계정. 없는 계정이면 처음 요청 때 자동으로 가입합니다 (비밀번호 8자 이상)
# 개발 서버(npm run dev)에서만 읽어요. 빌드(npm run build) 결과에는 들어가지 않습니다. 실제 계정 비밀번호는 넣지 마세요.
VITE_DEV_EMAIL=me@example.com
VITE_DEV_PASSWORD=change-me-1234
VITE_DEV_NAME=me
